import 'package:flutter/material.dart';
import 'package:flutter_riverpod/flutter_riverpod.dart';
import 'package:go_router/go_router.dart';
import 'package:intl/intl.dart';
import '../../../../data/database/app_database.dart';
import '../../domain/hesap.dart';

class AccountsScreen extends ConsumerWidget {
  const AccountsScreen({super.key});

  @override
  Widget build(BuildContext context, WidgetRef ref) {
    final db = ref.watch(databaseProvider);
    final currencyFormat = NumberFormat.currency(locale: 'tr_TR', symbol: '₺');

    return Scaffold(
      appBar: AppBar(title: const Text('Hesaplarım')),
      body: StreamBuilder<List<HesaplarData>>(
        stream: db.select(db.hesaplar).watch(),
        builder: (context, snapshot) {
          if (!snapshot.hasData) return const Center(child: CircularProgressIndicator());
          
          final hesaplar = snapshot.data!;
          
          // 🚨 ÖZET HESAPLAMALARI
          double toplamVarlik = 0;
          double toplamBorc = 0;
          for (var h in hesaplar) {
            if (h.bakiye >= 0) {
              toplamVarlik += h.bakiye;
            } else {
              toplamBorc += h.bakiye.abs(); // Borçları pozitif gösterelim
            }
          }
          final netToplam = toplamVarlik - toplamBorc;

          return Column(
            children: [
              // 🚨 ÜST ÖZET KARTI
              Container(
                padding: const EdgeInsets.symmetric(horizontal: 16, vertical: 12),
                color: Theme.of(context).colorScheme.surfaceVariant.withOpacity(0.3),
                child: Row(
                  mainAxisAlignment: MainAxisAlignment.spaceAround,
                  children: [
                    _OzetSutun(baslik: 'Varlıklar', tutar: toplamVarlik, renk: Colors.green, format: currencyFormat),
                    _OzetSutun(baslik: 'Borçlar', tutar: toplamBorc, renk: Colors.red, format: currencyFormat),
                    _OzetSutun(baslik: 'Net Toplam', tutar: netToplam, renk: netToplam >= 0 ? Colors.blue : Colors.red, format: currencyFormat),
                  ],
                ),
              ),
              const Divider(height: 1),
              
              // LİSTE
              Expanded(
                child: hesaplar.isEmpty
                    ? const Center(child: Text('Henüz hesap eklenmemiş.'))
                    : ListView.builder(
                        padding: const EdgeInsets.all(16),
                        itemCount: hesaplar.length,
                        itemBuilder: (context, index) {
                          final hesap = hesaplar[index];
                          final bakiyeNegatif = hesap.bakiye < 0;
                          
                          String? altMetin;
                          if (hesap.tur == HesapTuru.kmh && hesap.limitTutari != null) {
                            final kullanilan = hesap.bakiye < 0 ? hesap.bakiye.abs() : 0;
                            final kalanLimit = hesap.limitTutari! - kullanilan;
                            altMetin = 'Kalan Limit: ${currencyFormat.format(kalanLimit)}';
                          }

                          return Card(
                            margin: const EdgeInsets.only(bottom: 12),
                            child: ListTile(
                              onTap: () => context.push('/accounts/add', extra: hesap),
                              onLongPress: () => _silmeOnayiGoster(context, ref, db, hesap),
                              leading: CircleAvatar(child: Icon(_getIcon(hesap.tur))),
                              title: Text(hesap.ad, style: const TextStyle(fontWeight: FontWeight.bold)),
                              subtitle: Column(
                                crossAxisAlignment: CrossAxisAlignment.start,
                                children: [
                                  Text(hesap.tur.label),
                                  if (altMetin != null) 
                                    Text(altMetin, style: TextStyle(fontSize: 11, color: Colors.blue.shade700, fontWeight: FontWeight.w600)),
                                ],
                              ),
                              trailing: Text(
                                currencyFormat.format(hesap.bakiye),
                                style: TextStyle(fontWeight: FontWeight.w600, fontSize: 16, color: bakiyeNegatif ? Colors.red : Colors.green),
                              ),
                            ),
                          );
                        },
                      ),
              ),
            ],
          );
        },
      ),
      floatingActionButton: FloatingActionButton.extended(
        onPressed: () => context.push('/accounts/add'),
        icon: const Icon(Icons.add),
        label: const Text('Hesap Ekle'),
      ),
    );
  }

  Future<void> _silmeOnayiGoster(BuildContext context, WidgetRef ref, AppDatabase db, HesaplarData hesap) async {
    final onay = await showDialog<bool>(
      context: context,
      builder: (context) => AlertDialog(
        title: const Text('Hesabı Sil'),
        content: Text('"${hesap.ad}" hesabını ve varsa ilgili takvim kayıtlarını silmek istediğinize emin misiniz?'),
        actions: [
          TextButton(onPressed: () => Navigator.pop(context, false), child: const Text('İptal')),
          FilledButton(style: FilledButton.styleFrom(backgroundColor: Colors.red), onPressed: () => Navigator.pop(context, true), child: const Text('Sil')),
        ],
      ),
    );

    if (onay == true) {
      await (db.delete(db.kartTakvim)..where((t) => t.hesapId.equals(hesap.id))).go();
      await (db.delete(db.hesaplar)..where((t) => t.id.equals(hesap.id))).go();
      if (context.mounted) ScaffoldMessenger.of(context).showSnackBar(const SnackBar(content: Text('Hesap başarıyla silindi.')));
    }
  }

  IconData _getIcon(HesapTuru tur) {
    switch (tur) {
      case HesapTuru.nakit: return Icons.money;
      case HesapTuru.banka: return Icons.account_balance;
      case HesapTuru.krediKarti: return Icons.credit_card;
      case HesapTuru.bankaKarti: return Icons.credit_card_outlined;
      case HesapTuru.kmh: return Icons.warning_amber_rounded;
      case HesapTuru.kredi: return Icons.request_quote;
      case HesapTuru.tasarruf: return Icons.savings;
      case HesapTuru.diger: return Icons.wallet;
      default: return Icons.wallet;
    }
  }
}

// 🚨 Özet Sütunu Tasarımı
class _OzetSutun extends StatelessWidget {
  final String baslik;
  final double tutar;
  final Color renk;
  final NumberFormat format;

  const _OzetSutun({required this.baslik, required this.tutar, required this.renk, required this.format});

  @override
  Widget build(BuildContext context) {
    return Column(
      children: [
        Text(baslik, style: const TextStyle(fontSize: 12, color: Colors.grey, fontWeight: FontWeight.w600)),
        const SizedBox(height: 4),
        Text(
          format.format(tutar),
          style: TextStyle(fontSize: 14, fontWeight: FontWeight.bold, color: renk),
        ),
      ],
    );
  }
}
